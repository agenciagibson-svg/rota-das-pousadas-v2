# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store
.vercel
.env*

# Supabase CLI local link state (project ref, pooler URL — não é segredo, mas
# é metadado específico do ambiente; não deve ir para o histórico do git)
supabase/.temp/

# Cache incremental do TypeScript
*.tsbuildinfo

# O .env.example documenta cada variavel necessaria e nao contem segredo algum.
# Precisa estar versionado, apesar da regra `.env*` acima — sem ele, quem clona
# o projeto nao tem como saber o que configurar na Vercel.
!.env.example

# Saidas de depuracao geradas durante o desenvolvimento (build, testes, migrations).
erro-*.txt
estado-*.txt
push-*.txt
resultado-*.txt
tabelas-*.txt
