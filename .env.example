# === Rota das Pousadas — variáveis de ambiente ===
# Copie para .env.local e preencha. NUNCA commitar segredos.

# URL pública do site (SEO, canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://rotadaspousadas.com.br

# --- Supabase (obtido no painel do projeto) ---
# Públicas (client + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo — SOMENTE server-side. Nunca expor no client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (marketplace/split payment — cada pousada conecta a própria conta via OAuth) ---
# App OAuth da PLATAFORMA (registrado uma vez em Suas integrações > Aplicações no Mercado Pago).
# NUNCA o token de uma pousada — esse fica no banco (cifrado), não em env var.
# MERCADO_PAGO_APP_ID=
# MERCADO_PAGO_APP_SECRET=
# Secret de assinatura do webhook (Suas integrações > Webhooks > Chave secreta).
# MERCADO_PAGO_WEBHOOK_SECRET=
# Chave simétrica usada para cifrar/decifrar os tokens de cada pousada antes de gravar no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PAYMENT_TOKENS_ENCRYPTION_KEY=
# true durante testes (mesmo com conta real) — evita movimentar dinheiro de verdade.
# Remover (ou "false") quando for para produção.
# MERCADO_PAGO_TEST_MODE=true

# --- Mercado Pago Assinaturas (cobrança da PRÓPRIA Rota — assinatura mensal
# da pousada, R$59,90/mês) — API DIFERENTE do marketplace acima. Aqui a Rota
# é a cobradora: token de acesso da conta MP DE VERDADE da própria empresa
# (Suas integrações > Credenciais de produção), nunca de uma pousada.
# MERCADO_PAGO_PLATFORM_ACCESS_TOKEN=

# --- Cron jobs (Vercel Cron) ---
# Segredo que o Vercel Cron envia em `Authorization: Bearer <valor>` ao chamar
# /api/cron/canais (iCal) e /api/cron/expiracao (expira pré-reserva vencida).
# MESMO segredo para os dois — sem ele a rota responde 401 e nada roda.
# Configure o MESMO valor no painel da Vercel (Settings > Environment Variables)
# e aqui. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=

# --- Outras integrações (fases futuras; deixe vazio até ativar) ---
# STRIPE_SECRET_KEY=
# GOOGLE_MAPS_API_KEY=
# OPENAI_API_KEY=
# SENTRY_DSN=
